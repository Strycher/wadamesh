# CrowPanel Advance 7 (ESP32-P4) sdkconfig defaults — wadamesh crowpanel7 env.
# Hardware entries mirror DCC's production sdkconfig.defaults.crowpanel7 for the
# identical board (P4 rev <3.0, hex PSRAM, ESP-Hosted C6-over-SDIO pin map).
# Passed via board_build.cmake_extra_args = -DSDKCONFIG_DEFAULTS=... (the
# pioarduino `custom_sdkconfig` option is a pure-arduino feature and is NOT
# read by the hybrid arduino+espidf configure — learned on first build).

CONFIG_IDF_TARGET="esp32p4"

# Chip revision: DCC's CrowPanel 7 is ESP32-P4 rev v1.3 (eco2); rev <3.0 and
# >=3.0 are mutually exclusive ISA variants. Verify the dev unit's rev on the
# first authorized boot log (open question #7 in CROWPANEL7_PORT.md).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# CPU (360 MHz max for rev <3.0)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360

# PSRAM (hex mode @ 200 MHz)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# arduino-esp32 hard requirement (its CMake errors on anything else)
CONFIG_FREERTOS_HZ=1000

# Arduino runtime owns the app: main() spawns loopTask -> setup()/loop() (the
# shared src/main.cpp IS the app here — unlike the Tanmatsu, which has its own
# app_main). Also gates the declaration of feedLoopWDT(), which UITask's SD
# copy loop feeds (third-build lesson: without this the symbol doesn't exist
# AND setup() would never be called).
CONFIG_AUTOSTART_ARDUINO=y

# BT off for the scaffold: the P4 has no native BLE; the companion's BLE path
# goes over the hosted C6 and gets its own bring-up in Epic D (#9) — same
# staging the Tanmatsu port used (its build.sh gotchas apply when this flips).
# NimBLE-Arduino is also out of this env's lib_deps until then.
CONFIG_BT_ENABLED=n

# Experimental features (required for ESP-Hosted)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ESP-Hosted: WiFi via the onboard ESP32-C6 over 1-bit SDIO (DCC-verified pins)
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_1_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=1
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
# Data lines: V1.1/V1.2 rev wiring (D0=17 D1=16). V1.0=DCC used 14/15.
# hostedSetPins() in target.cpp is what actually takes effect (prebuilt arduino
# lib), but keep these consistent. See target.cpp note (#12).
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=17
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_1BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=32
# 10 MHz, NOT 40: Elecrow's own C6-upgrade tool uses 10000 for the 7" board
# (crowpanel-advanced-p4-c6-upgrade platformio.ini). DCC's unit tolerates
# 40 MHz; this unit's handshake dies at 40 with card-init still passing —
# classic marginal-signal-integrity signature (#12). Revisit upward only with
# on-device evidence at each step.
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=10000
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500

# A hosted-transport failure must NOT reboot the node (first-flash lesson:
# handshake timeout -> esp_hosted host self-reset -> infinite ~16 s boot loop,
# black screen, boot counter 328). With =n the failure surfaces as
# ESP_HOSTED_EVENT_TRANSPORT_FAILURE and the mesh/display keep running.
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
CONFIG_ESP_HOSTED_HOST_RESTART_NO_COMMUNICATION_WITH_SLAVE=n

# TLS buffer sizing (matches the S3 envs' MBEDTLS flags)
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
